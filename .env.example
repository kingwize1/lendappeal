# Local dev only (copy to .env). NEVER commit real keys; in production use GitHub secrets / `wrangler secret put`.
# --- order API (local dev server; in production these live on the Cloudflare Worker) ---
ORDER_SIGNING_SECRET=change-me
RESEND_API_KEY=            # empty = emails are written to ./outbox
FROM_EMAIL="LendAppeal <orders@lendappeal.com>"   # lendappeal.com must be verified in Resend
ORDER_TO_EMAIL=            # private mailbox that receives orders (set as a Worker secret in production)
PAYMENT_PROVIDER=manual    # manual (invoice emailed) | gray | redirect | stripe
GRAY_PAYMENT_URL=          # later: hosted payment page from Gray; placeholders {orderId} {amount} {amountCents}
INVOICE_PAYMENT_INSTRUCTIONS=   # optional text shown on the invoice under "How to pay"
# --- site build ---
SITE_URL=https://lendappeal.com   # local dev: http://localhost:4321
API_BASE=                  # empty = same origin (local). Production: the Worker URL
# --- daily blog generator (GitHub secret LLM_API_KEY in CI) ---
LLM_API_KEY=               # Gemini API key
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
TAVILY_API_KEY=
X_BEARER_TOKEN=
AUTO_PUBLISH=1
